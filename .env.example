# FlowLink environment template.
#
# Copy to .env and fill in real values. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Docker Compose reads .env automatically from the repository root. The two variables marked
# REQUIRED have no default: `docker compose up` fails with a named error if they are missing.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Signing key for JWT access tokens. Minimum 32 characters; the application will not start
# without it. Generate a fresh one per environment and never reuse it across environments:
#   openssl rand -base64 48
JWT_SECRET=

# Password for the PostgreSQL role the backend connects as.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Database (compose defaults shown; override only if you need to)
# ---------------------------------------------------------------------------
POSTGRES_DB=flowlink
POSTGRES_USER=postgres

# Read directly by the backend when it runs outside compose (see README, local development).
# Inside compose these are derived from POSTGRES_* above.
# DATABASE_URL=jdbc:postgresql://localhost:5432/flowlink
# DATABASE_USER=postgres
# DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# HTTP / origins
# ---------------------------------------------------------------------------

# Host port the site is published on.
HTTP_PORT=80

# Origin the browser loads the app from. Must match exactly (scheme, host, port) or the
# credentialed CORS preflight fails and every API call from the browser is blocked.
CORS_ORIGIN=http://localhost

# Base URL used to build links inside outbound emails.
FRONTEND_BASE_URL=http://localhost

# Auth cookies are marked Secure by default, which means a browser will only send them over
# HTTPS. Set to false ONLY for a plain-HTTP localhost stack; leaving it false in production
# exposes session cookies on the network.
COOKIE_SECURE=true

# SameSite policy for the auth cookies: Lax, Strict or None. None requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=Lax

# Absolute lifetime of a login in days, enforced regardless of refresh-token rotation.
SESSION_MAX_DAYS=30

# Regex of reverse proxies whose X-Forwarded-* headers are trusted. The default covers the
# RFC1918 ranges plus loopback, which is right for the bundled nginx. Widen it only if your
# load balancer sits on a public address, and never to a value that matches arbitrary clients:
# a client that can spoof its own address defeats the rate limiter.
# INTERNAL_PROXIES=

# ---------------------------------------------------------------------------
# Frontend build
# ---------------------------------------------------------------------------

# Backend base URL baked into the production bundle at build time. Leave EMPTY so the app
# issues same-origin relative requests that nginx proxies. An absolute URL here hard-codes a
# hostname into the JavaScript and bypasses the proxy.
REACT_APP_API_URL=

# ---------------------------------------------------------------------------
# Outbound mail (optional; disabled by default)
# ---------------------------------------------------------------------------

# With mail disabled, project invitations still arrive as in-app notifications.
APP_MAIL_ENABLED=false
MAIL_FROM=noreply@example.com
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Tuning (optional; the defaults in application.properties are sane)
# ---------------------------------------------------------------------------

# Filesystem directory for uploaded attachments and profile pictures. In compose this is a
# named volume mounted at /app/uploads.
# UPLOAD_DIR=uploads

# Connection pool.
# HIKARI_MIN_IDLE=5
# HIKARI_MAX_POOL=20

# Schedule optimizer objective weights (makespan vs. priority-weighted tardiness).
# OPT_ALPHA=0.8
# OPT_BETA=0.2

# Rate limits: requests per client address per window. RATE_LIMIT_LOGIN is additionally
# scoped per account.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_REGISTER=3
# RATE_LIMIT_WRITE=300
# RATE_LIMIT_OPTIMIZE=30
# RATE_LIMIT_SEARCH=120
# RATE_LIMIT_INVITATION=50

# ---------------------------------------------------------------------------
# API docs
# ---------------------------------------------------------------------------

# Gates springdoc's Swagger UI and raw OpenAPI JSON (/swagger-ui/*, /v3/api-docs*), both of which
# are reachable without an access token. Recommended false in production; leave true only where
# the docs need to stay browsable, e.g. local development.
# API_DOCS_ENABLED=true
